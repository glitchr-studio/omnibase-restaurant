{#
 # A table's phones (/t/{token}): the menu in ordering mode, the round being
 # put together, sent to the kitchen; the rounds already sent and where each
 # stands (asked again every few seconds); the waiter, the bill.
 #}
{% extends layout %}
{% block title %}{{ '@restaurant.table.title'|trans({table: table.label}) }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('bundles/restaurant/css/restaurant.css') }}">{% endblock %}

{% block content %}
{% set can_order = ordering and table.ordering and (session is null or session.status.value == 'open') %}
<section class="restaurant restaurant-table"
         data-controller="restaurant-table poll"
         data-restaurant-table-round-url-value="{{ path('restaurant_table_round', {token: table.token}) }}"
         data-restaurant-table-call-url-value="{{ path('restaurant_table_call', {token: table.token}) }}"
         data-restaurant-table-bill-url-value="{{ path('restaurant_table_bill', {token: table.token}) }}"
         data-restaurant-table-state-url-value="{{ path('restaurant_table_state', {token: table.token}) }}"
         data-restaurant-table-key-value="restaurant/table/{{ table.token }}/{{ session.id ?? 0 }}"
         data-restaurant-table-currency-value="{{ state.currency ?? 'EUR' }}"
         data-restaurant-table-locale-value="{{ app.request.locale }}"
         data-restaurant-table-statuses-value="{{ {new: '@restaurant.ticket.status.new'|trans, accepted: '@restaurant.ticket.status.accepted'|trans, preparing: '@restaurant.ticket.status.preparing'|trans, ready: '@restaurant.ticket.status.ready'|trans, served: '@restaurant.ticket.status.served'|trans, refused: '@restaurant.ticket.status.refused'|trans, cancelled: '@restaurant.ticket.status.cancelled'|trans}|json_encode }}"
         data-restaurant-table-texts-value="{{ {round: '@restaurant.table.round'|trans, sent: '@restaurant.table.sent'|trans, called: '@restaurant.table.called'|trans, bill: '@restaurant.table.bill_asked'|trans, error: '@restaurant.table.error.generic'|trans, empty: '@restaurant.table.nothing_yet'|trans}|json_encode }}"
         data-poll-url-value="{{ path('restaurant_table_state', {token: table.token}) }}"
         data-poll-key-value="revision" data-poll-since-value="0" data-poll-interval-value="{{ poll * 1000 }}"
         data-action="poll:change->restaurant-table#show">
    <header class="restaurant-head restaurant-table-head">
        <p class="restaurant-eyebrow" lang="ja">いらっしゃいませ</p>
        <h1>{{ '@restaurant.table.title'|trans({table: table.label}) }}</h1>
        <p class="restaurant-lead">{{ can_order ? '@restaurant.table.lead'|trans : (session and session.status.value != 'open' ? '@restaurant.table.bill_asked'|trans : '@restaurant.table.read_only'|trans) }}</p>
    </header>

    <nav class="restaurant-tabs" role="tablist">
        <button type="button" role="tab" class="is-on" data-action="restaurant-table#tab" data-tab="menu" aria-selected="true">{{ '@restaurant.table.tab_menu'|trans }}</button>
        <button type="button" role="tab" data-action="restaurant-table#tab" data-tab="rounds" aria-selected="false">{{ '@restaurant.table.tab_rounds'|trans }} <span class="restaurant-badge" data-restaurant-table-target="roundCount">{{ state.tickets|default([])|length ?: '' }}</span></button>
    </nav>

    <div class="restaurant-pane" data-pane="menu">
        <nav class="restaurant-sections is-sticky">
            {% for group in sections %}{% if group.section %}<a href="#t-{{ group.section.slug }}">{{ group.section.label }}</a>{% endif %}{% endfor %}
        </nav>
        {% for group in sections %}
        <section class="restaurant-section" id="t-{{ group.section.slug ?? 'autres' }}">
            <h2>{{ group.section.label ?? ('@restaurant.menu.other'|trans) }}{% if group.section and group.section.nativeName %} <span class="restaurant-native" lang="ja">{{ group.section.nativeName }}</span>{% endif %}</h2>
            <div class="restaurant-dishes">
                {% for dish in group.dishes %}{% include '@Restaurant/client/_dish.html.twig' with {order: can_order} %}{% endfor %}
            </div>
        </section>
        {% endfor %}
    </div>

    <div class="restaurant-pane" data-pane="rounds" hidden>
        <div data-restaurant-table-target="rounds" class="restaurant-rounds">
            {% for ticket in state.tickets|default([]) %}
            <div class="restaurant-round is-{{ ticket.status }}"><p><strong>{{ '@restaurant.table.round'|trans }} {{ ticket.round }}</strong> <span class="restaurant-pill">{{ ('@restaurant.ticket.status.' ~ ticket.status)|trans }}</span></p>
                <ul>{% for line in ticket.lines %}<li>{{ line.quantity }} × {{ line.name }}</li>{% endfor %}</ul></div>
            {% else %}
            <p class="restaurant-muted">{{ '@restaurant.table.nothing_yet'|trans }}</p>
            {% endfor %}
        </div>
        <p class="restaurant-total">{{ '@restaurant.table.total'|trans }} <strong data-restaurant-table-target="total">{{ (state.total ?? 0)|format_currency(state.currency ?? 'EUR', {use_rate: false}) }}</strong></p>
        {% if ordering %}
        <div class="restaurant-table-actions">
            <button type="button" class="restaurant-button is-quiet" data-action="restaurant-table#call" data-restaurant-table-target="callButton">{{ '@restaurant.table.call'|trans }}</button>
            <button type="button" class="restaurant-button is-quiet" data-action="restaurant-table#bill" data-restaurant-table-target="billButton" {{ session and session.status.value != 'open' ? 'disabled' }}>{{ '@restaurant.table.bill'|trans }}</button>
        </div>
        <p class="restaurant-muted">{{ pay_online ? '@restaurant.table.pay_online'|trans : '@restaurant.table.pay_till'|trans }}</p>
        {% endif %}
    </div>

    {% if can_order %}
    <aside class="restaurant-cart" data-restaurant-table-target="cart" hidden>
        <details>
            <summary><span data-restaurant-table-target="cartCount">0</span> · <strong data-restaurant-table-target="cartTotal"></strong></summary>
            <ul data-restaurant-table-target="cartList"></ul>
            <label class="restaurant-note">{{ '@restaurant.table.note'|trans }} <input type="text" maxlength="200" data-restaurant-table-target="note"></label>
        </details>
        <button type="button" class="restaurant-button" data-action="restaurant-table#send" data-restaurant-table-target="sendButton">{{ '@restaurant.table.send'|trans }}</button>
    </aside>
    {% endif %}
    <p class="restaurant-toast" data-restaurant-table-target="toast" role="status" hidden></p>
</section>
{% endblock %}
