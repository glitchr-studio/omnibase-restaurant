{# The guest's mail: what happened to the reservation, its details, the link to manage it (and the calendar file, attached). #}
{% set r = reservation %}
{% set locale = r.locale ?? 'fr' %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<body style="margin:0;padding:24px;background:#f6f3f7;font-family:Georgia,'Times New Roman',serif;color:#241b2b">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden">
    <tr><td style="background:#432B52;color:#ffffff;padding:20px 28px;font-size:20px">{{ ('mail.' ~ what ~ '.title')|trans({}, 'restaurant', locale) }}</td></tr>
    <tr><td style="padding:24px 28px;font-size:16px;line-height:1.5">
        <p>{{ 'mail.hello'|trans({name: r.name}, 'restaurant', locale) }}</p>
        <p>{{ ('mail.' ~ what ~ '.body')|trans({}, 'restaurant', locale) }}</p>
        <p style="font-size:18px"><strong>{{ r.startsAt|format_date('full', locale: locale) }} · {{ r.time }}</strong><br>
            {{ 'manage.covers'|trans({count: r.covers}, 'restaurant', locale) }}</p>
        {% if r.allergies %}<p>{{ 'book.allergies'|trans({}, 'restaurant', locale) }} : {{ r.allergies }}</p>{% endif %}
        {% if what not in ['cancelled', 'refused'] %}
        <p><a href="{{ manage_url }}" style="display:inline-block;padding:10px 18px;border-radius:999px;background:#E07A2F;color:#ffffff;text-decoration:none">{{ 'mail.manage'|trans({}, 'restaurant', locale) }}</a></p>
        {% endif %}
    </td></tr>
</table>
</body>
</html>
